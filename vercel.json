    {
      "src": "/tapin-stream/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/depok-stream/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/sukabumikab-stream/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/pekalongankab-stream/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
